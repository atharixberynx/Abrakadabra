# ─────────────────────────────────────────────────────────────
#  Variables de entorno del backend (API)
#  Copia este archivo como `.env` y completa los valores.
#  `.env` está en .gitignore: NUNCA lo subas al repositorio.
# ─────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development

# Puerto local de la API (Render asigna el suyo automáticamente)
PORT=4000

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers).
# Incluye el nombre de la base de datos antes del "?", p. ej. /abrakadabra?
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/abrakadabra?retryWrites=true&w=majority

# Secretos para firmar los tokens JWT. Deben ser distintos y largos (mín. 32 caracteres).
# Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-1
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo-y-aleatorio-2

# Orígenes permitidos para CORS, separados por comas (sin "/" final).
# Local: el servidor de Vite. Producción: el dominio de Vercel.
CLIENT_URL=http://localhost:5173

# Número de proxies delante de la API. En Render es 1.
# (Si el rate limit agrupa a todas las clientas en una IP, revisa README > Despliegue.)
TRUST_PROXY=1

# Cloudinary (Dashboard > API Keys). Necesario desde la Fase 4 para subir imágenes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Proveedor de pagos: simulated (pruebas) | wompi (pendiente de integrar)
PAYMENT_PROVIDER=simulated

# Primer administrador, creado con `npm run seed:admin` (Fase 2).
# Usa una contraseña fuerte y cámbiala en producción.
ADMIN_EMAIL=admin@abrakadabra.local
ADMIN_PASSWORD=CambiaEsta123

# Opcional: fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
