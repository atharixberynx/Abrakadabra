# ─────────────────────────────────────────────────────────────
#  Variables de entorno del frontend (Vite)
#  Copia este archivo como `.env` y ajusta los valores.
#  OJO: todo lo que empieza con VITE_ termina dentro del JavaScript público.
#  Nunca pongas aquí secretos ni contraseñas.
# ─────────────────────────────────────────────────────────────

# Ruta base de la API. Déjala en /api: en local la reenvía el proxy de Vite
# y en producción el rewrite de vercel.json (misma URL, cookie de primera parte).
VITE_API_URL=/api

# Número de WhatsApp de la tienda con código de país, sin "+", espacios ni guiones.
VITE_WHATSAPP_NUMBER=50300000000

# Enlace "Cómo llegar" de Google Maps (en Maps: Compartir > Copiar vínculo).
VITE_STORE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Centro+Comercial+Feria+Rosa+San+Salvador
